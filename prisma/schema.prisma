generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String      @id @default(uuid())
  consumerNumber String      @unique
  name           String
  password       String
  createdAt      DateTime    @default(now())
}

model Complaint {
  id             String   @id @default(uuid())
  consumerName   String
  consumerNumber String
  category       String
  area           String
  description    String
  status         String   @default("Received")
  createdAt      DateTime @default(now())

  // AI Analysis fields
  aiCategory     String?
  aiSummary      String?
  aiPriority     String?
  aiResponse     String?
}
